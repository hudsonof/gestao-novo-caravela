# Supabase PostgreSQL: Supabase Dashboard > Connect > Transaction pooler (runtime/Vercel, port 6543)
# Encode special characters in the password as URL-encoded values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?schema=public&pgbouncer=true&connection_limit=1"

# Supabase Dashboard > Connect > Session pooler (port 5432) or a direct connection.
# Used by Prisma CLI and database migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

AUTH_SECRET="replace-with-a-random-secret"
AUTH_TRUST_HOST=true
BUSINESS_TIME_ZONE="America/Sao_Paulo"
INITIAL_ADMIN_NAME="Administrador"
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
