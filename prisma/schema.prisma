generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
}

enum EventStatus {
  PLANNED
  OPEN
  CLOSING
  CLOSED
  CANCELLED
}

enum Sector {
  TICKETS
  TABLES
  BAR
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum AccountKind {
  FUND
  VAULT
  CASH
  BANK
  TRANSIT
  EXTERNAL
  RECEIVABLE
}

enum EntryKind {
  SALE
  EXPENSE
  TRANSFER
  ADJUSTMENT
  REVERSAL
  DEPOSIT
}

enum PaymentMethod {
  CASH
  PIX
  DEBIT
  CREDIT
  BANK_TRANSFER
}

enum ExpenseStatus {
  OPEN
  PARTIAL
  PAID
  CANCELLED
}

enum DepositStatus {
  PREPARED
  IN_TRANSIT
  CONFIRMED
  CANCELLED
}

model User {
  id              String        @id @default(uuid())
  name            String
  email           String        @unique
  passwordHash    String?
  role            UserRole      @default(MANAGER)
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  openedSessions  CashSession[] @relation("SessionOpenedBy")
  ledgerEntries   LedgerEntry[] @relation("LedgerCreator")
  closings        CashClosing[] @relation("ClosingManager")
  expensesCreated Expense[]         @relation("ExpenseCreator")
  expensePaymentsCreated ExpensePayment[] @relation("ExpensePaymentCreator")
  depositsCreated Deposit[]     @relation("DepositCreator")
  auditLogs       AuditLog[]    @relation("AuditActor")
}

model LoginAttempt {
  key             String   @id
  attempts        Int      @default(0)
  windowStartedAt DateTime @default(now())
  blockedUntil    DateTime?
  updatedAt       DateTime @updatedAt
}

model Employee {
  id        String        @id @default(uuid())
  name      String
  position  String?
  active    Boolean       @default(true)
  sessions  CashSession[]
}

model Event {
  id        String         @id @default(uuid())
  name      String
  startsAt  DateTime
  endsAt    DateTime?
  status    EventStatus    @default(PLANNED)
  notes     String?
  createdAt DateTime       @default(now())
  sessions  CashSession[]
  entries   LedgerEntry[]
  expenses  Expense[]

  @@index([startsAt])
  @@index([status, startsAt])
}

model CashRegister {
  id        String        @id @default(uuid())
  name      String        @unique
  sector    Sector
  active    Boolean       @default(true)
  sessions  CashSession[]
}

model FinancialAccount {
  id        String        @id @default(uuid())
  name      String        @unique
  kind      AccountKind
  balance   Decimal       @default(0) @db.Decimal(18, 2)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  session   CashSession?
  debits    LedgerEntry[] @relation("EntryDebit")
  credits   LedgerEntry[] @relation("EntryCredit")

  @@index([kind, active])
}

model CashSession {
  id             String        @id @default(uuid())
  eventId        String
  registerId     String
  accountId      String        @unique
  employeeId     String?
  openedById     String
  idempotencyKey String        @unique
  openingFloat   Decimal       @default(0) @db.Decimal(18, 2)
  openedAt       DateTime      @default(now())
  closedAt       DateTime?
  status         SessionStatus @default(OPEN)
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  register       CashRegister  @relation(fields: [registerId], references: [id], onDelete: Restrict)
  account        FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  employee       Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  openedBy       User          @relation("SessionOpenedBy", fields: [openedById], references: [id], onDelete: Restrict)
  entries        LedgerEntry[]
  closing        CashClosing?

  @@index([registerId, status])
  @@index([eventId, status])
}

model LedgerEntry {
  id              String           @id @default(uuid())
  eventId         String?
  sessionId       String?
  debitAccountId  String
  creditAccountId String
  kind            EntryKind
  method          PaymentMethod?
  category        String?
  amount          Decimal          @db.Decimal(18, 2)
  description     String
  idempotencyKey  String           @unique
  reversalOfId    String?          @unique
  createdById     String
  createdAt       DateTime         @default(now())
  event           Event?           @relation(fields: [eventId], references: [id], onDelete: Restrict)
  session         CashSession?     @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  debitAccount    FinancialAccount @relation("EntryDebit", fields: [debitAccountId], references: [id], onDelete: Restrict)
  creditAccount   FinancialAccount @relation("EntryCredit", fields: [creditAccountId], references: [id], onDelete: Restrict)
  createdBy       User             @relation("LedgerCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reversalOf      LedgerEntry?     @relation("EntryReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversals       LedgerEntry[]    @relation("EntryReversal")
  expensePayment  ExpensePayment?
  depositWithdrawal Deposit?       @relation("DepositWithdrawal")
  depositConfirmation Deposit?     @relation("DepositConfirmation")

  @@index([eventId, createdAt])
  @@index([sessionId, createdAt])
  @@index([debitAccountId, createdAt])
  @@index([creditAccountId, createdAt])
  @@index([kind, createdAt])
}

model CashClosing {
  id             String      @id @default(uuid())
  sessionId      String      @unique
  expectedAmount Decimal     @db.Decimal(18, 2)
  countedAmount  Decimal     @db.Decimal(18, 2)
  difference     Decimal     @db.Decimal(18, 2)
  justification  String?
  closedById     String
  createdAt      DateTime    @default(now())
  session        CashSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  closedBy       User        @relation("ClosingManager", fields: [closedById], references: [id], onDelete: Restrict)
}

model Expense {
  id             String          @id @default(uuid())
  idempotencyKey String          @unique
  eventId        String?
  description String
  category    String
  supplier    String?
  amount      Decimal         @db.Decimal(18, 2)
  dueDate     DateTime
  status      ExpenseStatus   @default(OPEN)
  createdById String
  createdAt   DateTime        @default(now())
  event       Event?          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  createdBy   User            @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  payments    ExpensePayment[]

  @@index([status, dueDate])
  @@index([eventId, dueDate])
}

model ExpensePayment {
  id          String      @id @default(uuid())
  expenseId   String
  entryId     String      @unique
  amount      Decimal     @db.Decimal(18, 2)
  paidAt      DateTime    @default(now())
  createdById String
  expense     Expense     @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  entry       LedgerEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  createdBy   User        @relation("ExpensePaymentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([expenseId, paidAt])
}

model Deposit {
  id             String        @id @default(uuid())
  amount         Decimal       @db.Decimal(18, 2)
  status         DepositStatus @default(IN_TRANSIT)
  withdrawalId   String        @unique
  confirmationId String?       @unique
  bankReference  String?
  createdById    String
  confirmedAt    DateTime?
  createdAt      DateTime      @default(now())
  withdrawal     LedgerEntry   @relation("DepositWithdrawal", fields: [withdrawalId], references: [id], onDelete: Restrict)
  confirmation   LedgerEntry?  @relation("DepositConfirmation", fields: [confirmationId], references: [id], onDelete: Restrict)
  createdBy      User          @relation("DepositCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String
  entity    String
  entityId  String
  action    String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
  actor     User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([entity, entityId, createdAt])
}
